<%# app/views/admin/index.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
<% end %>

<div class="bgOther">

  <div class="pageCon">
    <div class="topLine">
      <h1 class="title">Order Confirmation</h1>
      <a class="back" href="/admin">
        Back
        <%= image_tag "shop/Union.png",
            class: "arrow",
            alt: "Arrow"
        %>
      </a>
    </div>
    <div class="line"></div>

    <div class="usersCon">
      <% @users.each do |user| %>
          <div class="usersBox">
            <h1><%= user.name %></h1>
          </div>
      <% end %>
    </div>

  </div>

</div>