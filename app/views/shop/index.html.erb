<%# app/views/shop/index.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag asset_path("shop.css"), "data-turbo-track": "reload" %>
<% end %>

<div class="modalCon" data-controller="shop" data-action="click@document->shop#close" data-shop-target="modalCon">
  <div class="itemModal" data-shop-target="itemModal">
    <h1 class="prizeTitle">More Prize Info</h1>
    <div class="prizeInfo">
      <%= image_tag @selected_item&.image,
          class: "modalImage itemImage",
          alt: "Item Image" if @selected_item&.image&.attached? %>
      <h1 class="prizeName"><%= @selected_item&.name %></h1>
      <p class="prizeDesc"><%= @selected_item&.description %></p>
    </div>

      <%= form_with url: confirm_path, class: "modBtnCon",method: :get do |f| %>
        <%= f.hidden_field :shop_item_id, value: @selected_item&.id %>
        <div class="quantityCon">
          <button type="button" class="quantityBtn" data-action="click->shop#decrementQuantity">-</button>
          <%= f.number_field :quantity, value: 1, min: 1, class: "quantityInput", data: { shop_target: "quantity" } %>
          <button type="button" class="quantityBtn" data-action="click->shop#incrementQuantity">+</button>
        </div>
        <%= f.submit "Place Order", class: "orderBtn", disabled: (!@selected_item || @selected_item.hours.to_f > current_user.shipped_hours.to_f) %>
      <% end %>

      <%# if @selected_item %>
        <%#= button_to "Place Order",
            shop_path(shop_item_id: @selected_item&.id),
            class: "orderBtn",
            disabled: (@selected_item&.hours.to_f > current_user.shipped_hours.to_f),
            method: :post,
            params: { shop_item_id: @selected_item&.id }
        %>
      <%# end %>
  </div>
</div>

<div class="bg">
  <%= render "shared/nvb", user: current_user %>

  <div class="pageCon">
    <div class="topLine">
      <h1 class="title">Shop</h1>
      <a class="orders" href="/shop/my_orders">My Orders</a>
    </div>
    <div class="line"></div>

    <div class="ticketCon">
      <%= link_to shop_path(shop_item_id: @ticket_item&.id), class: "ticketBox", data: { shop_item_id: @ticket_item&.id } do %>
        <div class="infoCon">
          <h1 class="ticketTitle info"><%= @ticket_item&.name %></h1>
          <p class="ticketDesc info"><%= @ticket_item&.description %></p>
          <h1 class="ticketHours info"><%= @ticket_item&.hours %> hours</h1>
        </div>

        <%= image_tag @ticket_item&.image,
            class: "ticket",
            alt: "Fable Ticket" if @ticket_item&.image&.attached?
        %>
      <% end %>
    </div>

    <div class="shopCon">
      <div class="topRow">
        <h1>What if I can't make it?</h1>
        <h1>Shop Prizes</h1>
      </div>
      <div class="line"></div>
      <div class="grid">
        <% @shop_items.each do |item| %>

          <%= link_to shop_path(shop_item_id: item.id), class: "grid-item", data: { shop_item_id: item.id } do %>
            <%= image_tag item.image,
                class: "itemImage shopImage",
                alt: "Item Image" if item.image.attached? %>
            <h1 class="itemName"><%= item.name %></h1>
            <p class="itemDesc"><%= item.description %></p>
            <h1 class="itemHrs"><%= item.hours %> hours</h1>
          <% end %>

        <% end %>
      </div>
    </div>
  </div>
</div>