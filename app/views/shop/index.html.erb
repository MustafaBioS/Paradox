<%# app/views/shop/index.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "shop", "data-turbo-track": "reload" %>
<% end %>

<div class="modalCon">
  <div class="itemModal">
    <h1 class="prizeTitle">More Prize Info</h1>
    <div class="prizeInfo">
      <%= image_tag "pfp.png"%>
      <h1 class="prizeName"><%= @selected_item&.name %></h1>
      <p class="prizeDesc"><%= @selected_item&.description %></p>
    </div>
    <div class="btnCon">
      <%= button_to "ORDER", orders_path, class: "orderBtn", method: :post, params: { shop_item_id: @selected_item&.id } %>
    </div>
  </div>
</div>

<div class="bg">
  <%= render "shared/nvb", user: current_user %>

  <div class="pageCon">
    <div class="topLine">
      <h1 class="title">Shop</h1>
      <a class="orders" href="/orders">My Orders</a>
    </div>
    <div class="line"></div>

    <div class="ticketCon">
      <div class="ticketBox">
        <div class="infoCon">
          <h1 class="ticketTitle info">Ticket to Fable</h1>
          <p class="ticketDesc info">A ticket to a 5-day hackathon in the London idk actually insert stuff</p>
          <h1 class="ticketHours info">35 hours</h1>
        </div>

        <%= image_tag "shop/fable-ticket.png",
            class: "ticket",
            alt: "Fable Ticket"
        %>
      </div>
    </div>

    <div class="shopCon">
      <div class="topRow">
        <h1>What if I can't make it?</h1>
        <h1>Shop Prizes</h1>
      </div>
      <div class="line"></div>
      <div class="grid">
        <% @shop_items.each do |item| %>

          <%= link_to shop_path(shop_item_id: item.id), class: "grid-item", data: { shop_item_id: item.id } do %>
            <%= item.id %>
            <%= button_to "ORDER", orders_path, class: "orderBtn", method: :post, params: { shop_item_id: item.id } %>
          <% end %>

        <% end %>
      </div>
    </div>
  </div>
</div>