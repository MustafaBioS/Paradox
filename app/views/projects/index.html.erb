<%# app/views/projects/index.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "projects", "data-turbo-track": "reload" %>
<% end %>

<div class="bg">
<%= render "shared/nvb", user: current_user %>

  <div class="pageCon">
    <h1 class="title">Projects</h1>
    <div class="line"></div>
    <div class="blocksCon">
      <div class="projectsList">
        <% if @projects.empty? %>
          <div class="emptyCon" data-lenis-prevent>
            <h1 class="topDesc">No projects yet.</h1>
            <h1 class="botDesc">Make a new one!</h1>
          </div>
        <% else %>
          <div class="projects" data-lenis-prevent>
            <% @projects.each do |project| %>
              <%= link_to projects_path(project_id: project.id), class: "projectItem #{'active' if @selected_project == project}", data: { project_id: project.id } do %>
                <h1 class="projectName" data-role="project-title"><%= project.title %></h1>
                <div class="redRow">
                  <%= image_tag "projects/red-star.png",
                      class: "redStar",
                      alt: "Red Star"
                  %>
                  <h1 class="hrsRed">0.00 code hrs</h1>
                </div>
                <div class="blueRow">
                  <%= image_tag "projects/blue-star.png",
                      class: "blueStar",
                      alt: "Blue Star"
                  %>
                  <h1 class="hrsBlue">0.00 art hrs</h1>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <div class="btnCon">
          <%= button_to "+ new project", projects_path, method: :post, class: "botBtn" %>
        </div>
      </div>
      <% if @selected_project.present? %>
        <div class="projectDetails">
          <div class="titleCon">
            <div
              data-controller="title"
              data-title-url-value="<%= project_path(@selected_project) %>"
              data-title-project-id-value="<%= @selected_project.id %>"
              class="topCon"
            >
              <%= text_field_tag :title, @selected_project.title,
                   class: "projectTitle",
                   maxlength: 50,
                   data: { action: "input->title#save blur->title#save" }
                %>
            </div>
            <%= button_to project_path(@selected_project),
                    method: :delete,
                    class: "deleteBtn",
                    form: { class: "deleteForm" } do
            %>
              <%= image_tag "projects/trash.png",
                alt: "Trash Icon",
                class: "trash"
              %>
            <% end %>
          </div>
          <div class="hrsCon">
            <div class="codeHrsBox">
              <div class="rowCon">
                <h1 class="hrsRed">0.00 code hrs</h1>
                <%= image_tag "projects/red-star.png",
                    class: "redStar",
                    alt: "Red Star"
                %>
              </div>
              <p class="hackatimeText">select your Hackatime project(s)</p>
            </div>
            <div class="artHrsBox">
              <div class="rowCon">
                <h1 class="hrsBlue">0.00 code hrs</h1>
                <%= image_tag "projects/blue-star.png",
                    class: "blueStar",
                    alt: "Blue Star"
                %>
              </div>
              <p class="lapseText">select your Lapse project(s)</p>
            </div>
          </div>
          <div class="descThumb">
            <div class="descCon">
              <h1 class="descTitle botTitle">description</h1>
              <div
                data-controller="desc"
                data-desc-url-value="<%= project_path(@selected_project) %>"
                data-desc-project-id-value="<%= @selected_project.id %>"
                class="description"
              >
                  <%= text_area_tag :desc, @selected_project.description,
                   class: "desc",
                   maxlength: 100,
                   rows: 4,
                   data: { action: "input->desc#save blur->desc#save" }
                %>
              </div>
            </div>
            <div class="thumbCon">
              <h1 class="thumbTitle botTitle">thumbnail</h1>
              <h1 class="desc">< Insert Input Square Here ></h1>
            </div>
            <% if @selected_project.hours.present? %>
              <h1 class="botDesc">Hours: <%= @selected_project.hours %></h1>
            <% end %>
            <% if @selected_project.repo_url.present? %>
              <h1 class="botDesc">Repo: <%= @selected_project.repo_url %></h1>
            <% end %>
            <% if @selected_project.demo_url.present? %>
              <h1 class="botDesc">Demo: <%= @selected_project.demo_url %></h1>
            <% end %>
          </div>
        <% else %>
          <div class="projectDetailsEmpty">
            <h1 class="topDesc">You haven't selected a project yet.</h1>
            <h1 class="botDesc">Pick one from the sidebar to view details.</h1>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>