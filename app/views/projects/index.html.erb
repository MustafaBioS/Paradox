<%# app/views/projects/index.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "projects", "data-turbo-track": "reload" %>
<% end %>


<div class="modalCon">
  <div class="redModal"
       data-controller="hackatime"
       data-hackatime-project-id-value="<%= @selected_project&.id %>"
       data-hackatime-saved-names="<%= (@selected_project&.hackatime_projects || []).to_json %>"
  >
    <% @hackatime_projects&.each do |project| %>
      <p class="prjct"
         data-hackatime-target="project"
         data-seconds="<%= project["total_seconds"] || 0 %>"
         data-name="<%= project["name"] %>"
         data-action="click->hackatime#toggle">
        <%= project["name"] %> — <%= ((project["total_seconds"] || 0) / 3600.0).round(1) %> hours
      </p>
    <% end %>
    <button
      class="confirmBtn"
      data-action="click->hackatime#confirm"
    >
      Confirm
    </button>
  </div>
  <div class="blueModal">
    <h1>Select Lapse Projects</h1>
<!--    <div class="projectsBox">-->
      <%# if @hackatime_projects&.any? %>
        <%# @hackatime_projects.each do |project| %>
<!--          <p><%#= project["name"] %> — <%#= ((project["total_seconds"] || 0) / 3600.0).round(1) %> hours</p>-->
        <%# end %>
      <%# else %>
<!--        <p>No Hackatime data yet.</p>-->
      <%# end %>
<!--    </div>-->
  </div>
</div>

<div class="bg">
<%= render "shared/nvb", user: current_user %>

  <div class="pageCon">
    <h1 class="title">Projects</h1>
    <div class="line"></div>
    <div class="blocksCon">
      <div class="projectsList">
        <% if @projects.empty? %>
          <div class="emptyCon" data-lenis-prevent>
            <h1 class="topDesc">No projects yet.</h1>
            <h1 class="botDesc">Make a new one!</h1>
          </div>
        <% else %>
          <div class="projects" data-lenis-prevent>
            <% @projects.each do |project| %>
              <%= link_to projects_path(project_id: project.id), class: "projectItem", data: { project_id: project.id } do %>
                <h1 class="projectName" data-role="project-title"><%= project.title %></h1>
                <div class="redRow">
                  <%= image_tag "projects/red-star.png",
                      class: "redStar",
                      alt: "Red Star"
                  %>
                  <h1 class="hrsRed"><%= project.code_hours %> code hrs</h1>
                </div>
                <div class="blueRow">
                  <%= image_tag "projects/blue-star.png",
                      class: "blueStar",
                      alt: "Blue Star"
                  %>
                  <h1 class="hrsBlue">0.0 art hrs</h1>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <div class="btnCon">
          <% if current_user.hackatime_token.present? %>
            <%= button_to "+ new project", projects_path, method: :post, class: "botBtn" %>
          <% else %>
            <%= link_to "link hackatime", auth_hackatime_path, class: "botBtn" %>
          <% end %>
        </div>
      </div>
      <% if @selected_project.present? %>
        <div class="projectDetails">
          <div class="titleCon">
            <div
              data-controller="title"
              data-title-url-value="<%= project_path(@selected_project) %>"
              data-title-project-id-value="<%= @selected_project.id %>"
              class="topCon"
            >
              <%= text_field_tag :title, @selected_project.title,
                   class: "projectTitle",
                   maxlength: 50,
                   data: { action: "input->title#save blur->title#save" }
                %>
            </div>
            <%= button_to project_path(@selected_project),
                    method: :delete,
                    class: "deleteBtn",
                    form: { class: "deleteForm" } do
            %>
              <%= image_tag "projects/trash.png",
                alt: "Trash Icon",
                class: "trash"
              %>
            <% end %>
          </div>
          <div class="hrsCon">
            <div class="codeHrsBox">
              <div class="rowCon">
                <h1 class="hrsRed" data-hackatime-target="hours"><%= @selected_project.code_hours %> code hrs</h1>
                <%= image_tag "projects/red-star.png",
                    class: "redStar",
                    alt: "Red Star"
                %>
              </div>
              <p class="hackatimeText"><%= @selected_project.hackatime_projects.presence&.join(", ") || "select your Hackatime project(s)" %></p>
            </div>
            <div class="artHrsBox">
              <div class="rowCon">
                <h1 class="hrsBlue">0.00 code hrs</h1>
                <%= image_tag "projects/blue-star.png",
                    class: "blueStar",
                    alt: "Blue Star"
                %>
              </div>
              <p class="lapseText">select your Lapse project(s)</p>
            </div>
          </div>
          <div class="descThumb">
            <div class="descCon">
              <h1 class="descTitle botTitle">description</h1>
              <div
                data-controller="desc"
                data-desc-url-value="<%= project_path(@selected_project) %>"
                data-desc-project-id-value="<%= @selected_project.id %>"
                class="description"
              >
                  <%= text_area_tag :desc, @selected_project.description,
                   class: "desc",
                   maxlength: 100,
                   rows: 4,
                   data: { action: "input->desc#save blur->desc#save" }
                %>
              </div>
            </div>
          <%= form_with model: @selected_project, url: project_path(@selected_project), method: :patch, multipart: true do |f| %>
            <div class="thumbCon" data-controller="hackatime">
              <h1 class="thumbTitle botTitle">thumbnail</h1>
              <label>
                <div class="thumbBox">
                    <% if @selected_project&.thumbnail&.attached? %>
                      <%= image_tag @selected_project.thumbnail, class: "previewImage" %>
                    <% else %>
                      <h1>Upload image here</h1>
                    <% end %>
                    <input type="file" name="project[thumbnail]" accept="image/*" class="hiddenInput" required data-action="change->hackatime#previewImage" />
                </div>
              </label>
            </div>
          <% end %>
          </div>

          <div class="shipCon">
            <% if @selected_project.status == "unshipped" %>
              <% if project_ready_for_shipping?(@selected_project) %>
                <%= link_to "SHIP!", project_checklist_path(@selected_project.id), class: "shipBtn" %>
              <% else %>
                <% ship_reasons = shipping_incomplete_reasons(@selected_project) %>
                <span class="shipBtn shipBtnDisabled" aria-disabled="true" title="<%= ship_reasons.join(' ') %>">
                  SHIP!
                  <span class="shipBtnTooltip">
                    <% ship_reasons.each do |reason| %>
                      <span class="shipBtnTooltipLine"><%= reason %></span>
                    <% end %>
                  </span>
                </span>
              <% end %>

            <% else %>
              <% if project_ready_for_shipping?(@selected_project) %>
                <%= link_to "RE-SHIP!", project_checklist_path(@selected_project.id), class: "shipBtn" %>
              <% else %>
                <% ship_reasons = shipping_incomplete_reasons(@selected_project) %>
                <span class="shipBtn shipBtnDisabled" aria-disabled="true" title="<%= ship_reasons.join(' ') %>">
                  RE-SHIP!
                  <span class="shipBtnTooltip">
                    <% ship_reasons.each do |reason| %>
                      <span class="shipBtnTooltipLine"><%= reason %></span>
                    <% end %>
                  </span>
                </span>
              <% end %>
            <% end %>
          </div>

        </div>
        <% else %>
          <div class="projectDetailsEmpty">
            <h1 class="topDesc">You haven't selected a project yet.</h1>
            <h1 class="botDesc">Pick one from the sidebar to view details.</h1>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>