<%# app/views/home/index.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "home", "data-turbo-track": "reload" %>
<% end %>

<div
  class="bg"
>
  <%= render "shared/nvb", user: current_user %>

  <div class="pageCon">
    <div class="remainingCon">
      <%= image_tag "home/clock.png",
          alt: "Clock",
          class: "clock"
      %>
      <h1 class="remaining">35</h1>
      <div class="untilCon">
        <p class="ptag">hours until</p>
        <p class="ptag">you escape the Paradox</p>
      </div>
    </div>
    <div class="line"></div>
    <div class="bottom">
      <div class="tempBox">???</div>
    </div>
    <div class="catCon">
      <div class="textCloud">
        <div class="cloud">Bomboclatt message #67</div>
        <div class="cloudArrow"></div>
      </div>
      <%= image_tag "home/cat.png",
          alt: "Cat",
          class: "cat"
      %>
    </div>
  </div>
</div>