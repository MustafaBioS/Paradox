<%# app/views/home/index.html.erb %>


<% content_for :head do %>
  <%= stylesheet_link_tag "home", "data-turbo-track": "reload" %>
<% end %>

<div class="bg">
  <%= render "shared/nvb", user: current_user %>

  <div class="pageCon">
    <div class="remainingCon">
      <%= image_tag "home/clock.png",
          alt: "Clock",
          class: "clock"
      %>
      <h1 class="remaining"><%= [35 - current_user.shipped_hours, 0].max %></h1>
      <div class="untilCon">
        <p class="ptag">hours until</p>
        <p class="ptag">you escape the Paradox</p>
      </div>
    </div>
    <div class="line"></div>
    <div class="annCon">
      <% if @announcements.present? %>
        <% @announcements.each do |ann| %>
          <div class="annBox" data-link="<%= ann[:link] %>">
            <div class="top">
              <%= image_tag "https://cachet.dunkirk.sh/users/#{ann[:user]}/r", class: "annPfp", alt: "#{ann[:user]}" %>
              <h1 class="name">@Mustafa</h1>
            </div>
            <div class="msgCon">
              <p class="msg">
                <%= ann[:text] %>
              </p>
            </div>
          </div>
        <% end %>
    <% else %>
      <div class="noneCon">
        <h1 class="none">No Announcements Available</h1>
      </div>
    <% end %>
    </div>
    <div class="catCon">
      <div class="textCloud">
        <div class="cloud"></div>
        <div class="arrowCon">
          <div class="cloudArrow"></div>
        </div>
      </div>
      <%= image_tag "home/cat.png",
          alt: "Cat",
          class: "cat",
          onclick: "randomMessage()"
      %>
    </div>
  </div>
</div>

<script>
  const messages = <%= raw json_escape(@messages.to_json) %>;
  const announcements = <%= raw @announcements.to_json %>;

  document.addEventListener("DOMContentLoaded", () => {
      document.querySelector(".annCon").addEventListener("click", (e) => {
          const card = e.target.closest(".annBox");
          if (!card) return;

          const link = card.dataset.link;
          if (link) {
              window.open(link, "_blank");
          }
      });
  });

  function randomMessage() {
    const cloud = document.querySelector(".cloud");
    const textCloud = document.querySelector(".textCloud");
    const cat = document.querySelector(".cat");
    if (!cloud || !textCloud || !Array.isArray(messages) || messages.length === 0) return;

    const index = Math.floor(Math.random() * messages.length);
    cloud.textContent = messages[index];
    textCloud.classList.add("is-visible");

    if (cat) {
      cat.classList.add("squashed");
      setTimeout(() => cat.classList.remove("squashed"), 140);
    }
  }
</script>